APP_NAME="FormForge AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 (XAMPP defaults shown)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=formforge_ai
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Default filesystem disk: local maps to storage/app/private (not web-accessible).
# Do not use the "public" disk or storage:link for submission/import files.
FILESYSTEM_DISK=local

# Database queue (Phase 1 default). Run: php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# FormForge AI
# -----------------------------------------------------------------------------

# Uploads (private local disk — never use "public" for submission/import files)
FORMFORGE_UPLOAD_DISK=local
FORMFORGE_MAX_FILE_SIZE_KB=5120

# OpenAI — required for AI generation and AI editing. Never commit real keys.
# Leave empty to disable AI: the builder refuses the action instead of queueing
# a job that would only fail.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FORMFORGE_AI_MODEL=gpt-4o-mini
FORMFORGE_AI_TEMPERATURE=0.2
FORMFORGE_AI_MAX_TOKENS=4096
# Repair calls allowed AFTER the initial call, so 3 means at most 4 calls.
FORMFORGE_AI_MAX_REPAIR_ATTEMPTS=3
FORMFORGE_AI_TIMEOUT=60
FORMFORGE_AI_MAX_PROMPT_CHARS=2000

# DOCX/XLSX import. Files land on the private upload disk and are deleted as
# soon as the preview is written.
FORMFORGE_IMPORT_MAX_FILE_SIZE_KB=10240
FORMFORGE_IMPORT_STALE_AFTER_MINUTES=60
FORMFORGE_IMPORT_MAX_ARCHIVE_ENTRIES=512
FORMFORGE_IMPORT_MAX_UNCOMPRESSED_BYTES=67108864

# Cache / queues / export / public / activity
FORMFORGE_SCHEMA_CACHE_TTL=3600
FORMFORGE_QUEUE_AI=default
FORMFORGE_QUEUE_IMPORT=default
FORMFORGE_QUEUE_EXPORT=default
FORMFORGE_QUEUE_DEFAULT=default
FORMFORGE_EXPORT_SYNC_MAX_ROWS=500
FORMFORGE_EXPORT_CSV_CHUNK=200
FORMFORGE_PUBLIC_RATE_LIMIT=10
FORMFORGE_LOG_SUBMISSIONS=false
FORMFORGE_ACTIVITY_ENABLED=true
